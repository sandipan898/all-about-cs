# =============================================================================
# All About CS — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for local development.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SEO & Analytics ---
# Umami analytics (self-hosted, cookieless). Both must be set for tracking to
# activate; when unset, no tracker script is emitted.
#   SRC        = URL of your Umami tracker script
#   WEBSITE_ID = the website UUID shown in your Umami dashboard
NEXT_PUBLIC_UMAMI_SRC=https://analytics.allaboutcs.dev/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Google Analytics 4 is parked (not wired in) at src/_deferred/analytics/ga.tsx.
# To re-enable it, restore that component and set NEXT_PUBLIC_GA_ID here.
# Google Search Console verification token (the content of the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token (msvalidate.01 meta content).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Code Execution (Wandbox) ---
# Server-side languages (C++, Java, Go, Rust, etc.) run via Wandbox
# (https://wandbox.org) — a FREE, public, key-less service. No registration or
# API key is required; it works out of the box. Python & JavaScript run in the
# browser and need nothing here. Only set this if you self-host Wandbox:
# WANDBOX_API_URL=https://wandbox.org/api

# --- Ads ---
# Kill switch: "true" to enable, "false" to disable (zero UI impact when off)
NEXT_PUBLIC_ENABLE_ADS=false
# Provider: "house" (internal fallback) | "adsense" | "ethical"
NEXT_PUBLIC_AD_PROVIDER=house
# Only needed when AD_PROVIDER=adsense
NEXT_PUBLIC_ADSENSE_ID=
